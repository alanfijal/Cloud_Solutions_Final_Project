{
  "name": "coldchain-console",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && prettier --check src index.html vite.config.ts tsconfig.json package.json",
    "format": "prettier --write src index.html vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "lucide-react": "1.75.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.11.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
